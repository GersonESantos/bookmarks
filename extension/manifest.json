{
    "manifest_version": 3,
    "name": "Bookmark Extension",
    "version": "1.0",
    "permissions": [
        "sidePanel",
        "tabs",
        "cookies",
        "storage"
    ],
    "host_permissions": [
        "http://localhost:8800/*"
    ],
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "action": {
        "default_title": "Open Side Panel"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    }
}